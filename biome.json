{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!.netlify",
      "!!data/seed",
      "!!pnpm-lock.yaml",
      "!!apps/web/public/tmdb.svg",
      "!!data/*.local.json",
      "!!data/catalog.json",
      "!!data/media.json",
      "!!data/catalog-report.json",
      "!!data/*.local.json.tmp"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
