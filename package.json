{
  "name": "cineclue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "node --experimental-strip-types apps/api/src/server.ts",
    "db:migrate": "node --experimental-strip-types apps/api/src/migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/import_movies/seed.ts",
    "data:validate": "node --experimental-strip-types scripts/validate_dataset/index.ts",
    "data:expand": "node --env-file-if-exists=.env scripts/import_movies/expand.ts",
    "data:import": "node --experimental-strip-types scripts/import_movies/index.ts",
    "test": "vitest run",
    "test:backend": "vitest run --project backend",
    "test:frontend": "vitest run --project frontend",
    "test:integration": "RUN_DB_TESTS=1 vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm data:validate && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "data:daily": "node scripts/import_movies/build-daily-pool.ts",
    "data:media": "node scripts/import_movies/enrich-studio-media.ts",
    "data:genres": "node --env-file-if-exists=.env scripts/import_movies/refresh-genres.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "description": "A daily film deduction game with shared puzzles, unlimited play and friend challenges.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0then0/CineClue.git"
  },
  "homepage": "https://github.com/0then0/CineClue#readme",
  "bugs": {
    "url": "https://github.com/0then0/CineClue/issues"
  }
}
